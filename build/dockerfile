ARG PLATFORM=linux/arm64
# The base image, from build/versions.json (ALPINE), so it moves with the weekly version update.
ARG BASE

FROM --platform=${PLATFORM} ${BASE}

ARG SRC=src

ADD ${SRC} /var/www/multi-az-workshop-application
# Upgrade the base image's packages first: a base image can lag behind
# package fixes published after it was cut.
RUN apk --no-cache upgrade && apk --no-cache add curl libstdc++ libgcc

EXPOSE 5000
ENTRYPOINT [ "/var/www/multi-az-workshop-application/multi-az-workshop-application" ]