ARG PLATFORM=linux/arm64
# The base image, from build/versions.json (ALPINE), so it moves with the weekly version update. No
# default: a second copy of the version here would drift. build:assets passes it.
ARG BASE

FROM --platform=${PLATFORM} ${BASE}
RUN apk upgrade --no-cache

ARG SRC=src

RUN apk --no-cache add curl libstdc++ libgcc
ADD ${SRC} /var/www/multi-az-workshop-application

EXPOSE 5000
ENTRYPOINT [ "/var/www/multi-az-workshop-application/multi-az-workshop-application" ]
